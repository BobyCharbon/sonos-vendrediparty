      "css": ".ds-jump{display:flex;flex-direction:column;align-items:center;justify-content:center;width:108px;height:108px;border-radius:50%;background:#16444cb3;color:#fffbed;border:3px solid #fffbed;touch-action:none;box-shadow:0 6px 18px #16444c30;cursor:pointer}.ds-jump svg{width:38px;height:38px}.ds-jump span{font:800 16px sans-serif}.ds-jump:active:not(:disabled){background:#276b61;transform:scale(.95)}.ds-jump:focus-visible{outline:3px solid #163d3a;outline-offset:4px}.ds-jump:disabled{opacity:.55;cursor:default}",
