  "narrative": {
    "northStar": "The approved tropical island",
    "overview": "This document applies only to L’île qui s’effondre, implemented in `app/static/island.css`, `island-scene.js`, and `island.js`. It does not establish a redesign of other Vendredi Party games or the shared shell. The approved tropical concept supplies the world: turquoise sea, grassy rocky islands, friendly colorful characters, cream panels, and green actions.\n\nThe arena is real, readable, playable 3D. Its current geometry is deliberately simpler than the approved concept illustration; the illustration is visual direction, not a claim of rendering parity. Large controls and clear identity cues support each player on an individual phone, with keyboard controls on desktop.",
    "keyCharacteristics": [
      "A turquoise ocean around grassy hexagonal rock platforms.",
      "Warm cream information surfaces above the scene.",
      "Colorful rounded characters with a separate white local-player arrow.",
      "Readable danger through orange terrain and thick geometric fractures."
    ],
    "rules": [
      {
        "name": "The Warning Rule",
        "body": "Keep orange terrain and geometric fractures together so the warning survives without motion or color discrimination.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep the arena and local character readable in portrait and landscape.",
      "Do preserve the cream panels, green actions, and tropical materials on this surface.",
      "Do pair orange danger with visible fractures and keep the white identity arrow separate from the name.",
      "Do keep touch controls, keyboard focus, and reduced-motion behavior available."
    ],
    "donts": [
      "Don't apply this island-specific palette to unrelated games by default.",
      "Don't use a static concept image as a substitute for playable geometry.",
      "Don't make terrain warnings depend on color or shaking alone.",
      "Don't claim real-phone performance or concept-level fidelity from browser screenshots."
    ]
  }
}
