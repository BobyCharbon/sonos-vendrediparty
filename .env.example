# Code pour accéder à /admin
ADMIN_PIN=1234

# App Spotify (https://developer.spotify.com/dashboard) — sert uniquement à la recherche
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=CH

# IP d'une enceinte Sonos (n'importe laquelle) : nécessaire si le serveur
# n'est pas sur le même sous-réseau que les Sonos (la découverte auto ne traverse pas les VLAN)
SONOS_IP=192.168.50.186


# Derrière un reverse proxy (HAProxy) : IP du proxy, pour récupérer la vraie IP des invités
FORWARDED_ALLOW_IPS=127.0.0.1

# Retours → Claude (admin, bouton 🤖) : jeton GitHub « fine-grained » limité à ce dépôt,
# permission « Issues : Read and write » uniquement. Vide = bouton désactivé (le prompt reste copiable).
GITHUB_TOKEN=
GITHUB_REPO=BobyCharbon/sonos-vendrediparty
